# Tan 后端密钥。
#
# 将此文件复制为 `.env`（放在启动服务器的同一目录中），然后填写各项值。
# 服务器启动时会通过 pydantic-settings 读取该文件。
#
# 此文件只包含密钥。其他配置（模型列表、CORS 来源、数据库路径和图片存储）都在
# `config.yaml` 中，该文件可以安全地提交到版本控制。本文件必须保持 git-ignored。

# Flutter 客户端每次请求都必须携带共享 bearer token。
# 可以生成一个较长的随机字符串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=change-me-to-a-long-random-string

# 上游 provider 的 API key。`config.yaml` 中的每个模型都会在 `api_key` 字段中按名称
# 引用其中一个。请根据配置的模型添加所需的 key；只有被模型引用的 key 才需要设置。

# OpenAI API key。由 `api_key: OPENAI_API_KEY` 的模型引用。
OPENAI_API_KEY=sk-...

# Anthropic API key。由 `api_key: ANTHROPIC_API_KEY` 的模型引用。
ANTHROPIC_API_KEY=sk-ant-...
