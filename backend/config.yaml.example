# Parlo 后端配置文件。
#
# 将此文件复制为 `config.yaml`（放在启动服务器的同一目录中）并进行编辑。
# 服务器启动时会通过 `load_config` 读取该文件。
#
# 此文件不包含任何密钥。API key 和共享 auth token 保存在 `.env` 中；下面的每个模型
# 都在 `api_key` 字段中按环境变量名引用对应的 key，因此实际密钥不会出现在此处。
# 所以可以安全地将 `config.yaml` 提交到版本控制。

# 创建新会话且未明确选择模型时使用的默认模型。必须与下方 `models` 中某个条目的
# `id` 匹配。
default_model: claude-sonnet-5

# 不包含密钥的服务器运行参数。
server:
  # CORS 允许的来源。Flutter Web 构建产物运行在独立来源上，因此请填写用户访问的
  # 地址，例如 http://your-server，或本地开发时使用的 http://localhost:8080。
  cors_origins:
    - http://localhost:8080

# SQLite 数据库 URL。默认会将数据库文件存储在 ./data 下。
database:
  url: sqlite+aiosqlite:///./data/parlo.db

# 图片上传存储。
images:
  # 存储上传图片的目录。
  upload_dir: ./data/images
  # 图片上传大小上限，单位为字节（默认 10 MiB）。
  max_bytes: 10485760

# 可用模型。请按需添加或删除条目；每个条目的 `api_key` 字段都指定了必须在 `.env`
# 中设置的环境变量名。
models:
  - id: gpt-5.6
    display_name: GPT-5.6
    api_key: OPENAI_API_KEY
    base_url: https://api.openai.com/v1
    family: openai
    protocol: openai-response
    vision: true
    # 此模型支持的 thinking-effort 级别。创建新会话时使用第一个级别作为默认值。
    thinking_effort:
      - medium
      - low
      - high
      - xhigh
    # 发送给上游的输出预算（thinking + 可见文本）上限。
    max_tokens: 32768

  - id: claude-sonnet-5
    display_name: Claude Sonnet 5
    api_key: ANTHROPIC_API_KEY
    base_url: https://api.anthropic.com
    family: anthropic
    protocol: anthropic-message
    vision: true
    thinking_effort:
      - high
      - medium
      - low
      - xhigh
      - max
    max_tokens: 65536

  - id: claude-opus-4-8
    display_name: Claude Opus 4.8
    api_key: ANTHROPIC_API_KEY
    base_url: https://api.anthropic.com
    family: anthropic
    protocol: anthropic-message
    vision: true
    thinking_effort:
      - high
      - medium
      - low
      - xhigh
      - max
    max_tokens: 32768
