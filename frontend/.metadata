# 此文件记录 Flutter 项目的属性。
# Flutter tool 使用它评估 capabilities 并执行 upgrade 等操作。
#
# 此文件应纳入 version control，不应手动编辑。

version:
  revision: "ee80f08bbf97172ec030b8751ceab557177a34a6"
  channel: "stable"

project_type: app

# 记录 flutter migrate command 的 metadata。
migration:
  platforms:
    - platform: root
      create_revision: ee80f08bbf97172ec030b8751ceab557177a34a6
      base_revision: ee80f08bbf97172ec030b8751ceab557177a34a6
    - platform: web
      create_revision: ee80f08bbf97172ec030b8751ceab557177a34a6
      base_revision: ee80f08bbf97172ec030b8751ceab557177a34a6

  # User 提供的 section。

  # 应被 migrate tool 忽略的 Local path list（相对于此 file）。
  #
  # 不属于 template 的 file 默认会被忽略。
  unmanaged_files:
    - 'lib/main.dart'
    - 'ios/Runner.xcodeproj/project.pbxproj'
